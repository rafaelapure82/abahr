// ══════════════════════════════════════════════════════════════════════════════
//  ABA Talent Management – Prisma Schema
//  PostgreSQL (NeonDB compatible)
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  HR_MANAGER
  MANAGER
  EMPLOYEE
  RECRUITER
  PAYROLL_ADMIN
  VIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
  PROBATION
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  BEREAVEMENT
  PUBLIC_HOLIDAY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum RecruitmentStatus {
  OPEN
  IN_REVIEW
  CLOSED
  ON_HOLD
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LEAVE_REQUEST
  PAYROLL
  ONBOARDING
  PERFORMANCE
  RECRUITMENT
  SYSTEM
}

enum DocumentType {
  CONTRACT
  ID
  PASSPORT
  CERTIFICATE
  PERFORMANCE_REVIEW
  TAX_FORM
  OTHER
}

enum PerformanceRating {
  EXCEPTIONAL
  EXCEEDS_EXPECTATIONS
  MEETS_EXPECTATIONS
  NEEDS_IMPROVEMENT
  UNSATISFACTORY
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(EMPLOYEE)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  refreshToken   String?
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee       Employee?
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
}

// ─── Employees ───────────────────────────────────────────────────────────────
model Employee {
  id               String           @id @default(uuid())
  employeeCode     String           @unique
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Info
  firstName        String
  lastName         String
  displayName      String?
  gender           Gender?
  dateOfBirth      DateTime?
  nationality      String?
  phone            String?
  personalEmail    String?
  address          String?
  city             String?
  country          String?
  avatarUrl        String?

  // Employment Info
  jobTitle         String
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(PROBATION)
  hireDate         DateTime         @default(now())
  terminationDate  DateTime?
  probationEndDate DateTime?

  // Organizational
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])
  managerId        String?
  manager          Employee?        @relation("DirectReports", fields: [managerId], references: [id])
  directReports    Employee[]       @relation("DirectReports")
  positionId       String?
  position         Position?        @relation(fields: [positionId], references: [id])

  // Compensation
  baseSalary       Decimal          @default(0) @db.Decimal(12, 2)
  currency         String           @default("USD")
  bankAccount      String?
  bankName         String?

  // Relations
  documents        Document[]
  leaves           Leave[]
  attendances      Attendance[]
  payrollItems     PayrollItem[]
  recruiterOf      JobApplication[]
  performanceReviewsAsEmployee PerformanceReview[] @relation("RevieweeReviews")
  performanceReviewsAsReviewer PerformanceReview[] @relation("ReviewerReviews")
  benefits         EmployeeBenefit[]
  onboarding       Onboarding?
  workExperiences  WorkExperience[]
  educations       Education[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("employees")
}

// ─── Departments ──────────────────────────────────────────────────────────────
model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  description String?
  parentId    String?
  parent      Department?  @relation("SubDepartments", fields: [parentId], references: [id])
  children    Department[] @relation("SubDepartments")
  headId      String?      // Employee managing this dept
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employees   Employee[]
  positions   Position[]
  payrolls    Payroll[]

  @@map("departments")
}

model Position {
  id           String      @id @default(uuid())
  title        String
  code         String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  level        Int         @default(1)
  minSalary    Decimal?    @db.Decimal(12, 2)
  maxSalary    Decimal?    @db.Decimal(12, 2)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employees    Employee[]

  @@map("positions")
}

// ─── Documents ───────────────────────────────────────────────────────────────
model Document {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         DocumentType @default(OTHER)
  name         String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  isVerified   Boolean      @default(false)
  expiresAt    DateTime?
  uploadedAt   DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("documents")
}

// ─── Leaves / PTO ────────────────────────────────────────────────────────────
model Leave {
  id           String      @id @default(uuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  type         LeaveType
  status       LeaveStatus @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  daysRequested Decimal    @db.Decimal(4, 1)
  reason       String?
  approverId   String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("leaves")
}

model LeaveBalance {
  id         String    @id @default(uuid())
  employeeId String    @unique
  year       Int
  annual     Decimal   @default(0) @db.Decimal(5, 1)
  sick       Decimal   @default(0) @db.Decimal(5, 1)
  other      Decimal   @default(0) @db.Decimal(5, 1)
  updatedAt  DateTime  @updatedAt

  @@map("leave_balances")
}

// ─── Attendance ───────────────────────────────────────────────────────────────
model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         DateTime  @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  hoursWorked  Decimal?  @db.Decimal(4, 2)
  isRemote     Boolean   @default(false)
  note         String?
  createdAt    DateTime  @default(now())

  @@unique([employeeId, date])
  @@map("attendances")
}

// ─── Payroll ──────────────────────────────────────────────────────────────────
model Payroll {
  id             String        @id @default(uuid())
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  status         PayrollStatus @default(DRAFT)
  totalGross     Decimal       @default(0) @db.Decimal(14, 2)
  totalNet       Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal      @default(0) @db.Decimal(14, 2)
  processedBy    String?
  processedAt    DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          PayrollItem[]

  @@map("payrolls")
}

model PayrollItem {
  id             String    @id @default(uuid())
  payrollId      String
  payroll        Payroll   @relation(fields: [payrollId], references: [id])
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  baseSalary     Decimal   @db.Decimal(12, 2)
  grossPay       Decimal   @db.Decimal(12, 2)
  netPay         Decimal   @db.Decimal(12, 2)
  regularHours   Decimal   @default(0) @db.Decimal(6, 2)
  overtimeHours  Decimal   @default(0) @db.Decimal(6, 2)
  overtimePay    Decimal   @default(0) @db.Decimal(12, 2)
  bonus          Decimal   @default(0) @db.Decimal(12, 2)
  deductions     Json      @default("[]")  // [{ name, amount }]
  allowances     Json      @default("[]")  // [{ name, amount }]
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  currency       String    @default("USD")
  createdAt      DateTime  @default(now())

  @@map("payroll_items")
}

// ─── Recruitment ─────────────────────────────────────────────────────────────
model Job {
  id               String            @id @default(uuid())
  title            String
  departmentId     String?
  description      String
  requirements     String?
  responsibilities String?
  type             EmploymentType    @default(FULL_TIME)
  status           RecruitmentStatus @default(OPEN)
  salaryMin        Decimal?          @db.Decimal(12, 2)
  salaryMax        Decimal?          @db.Decimal(12, 2)
  location         String?
  isRemote         Boolean           @default(false)
  openingsCount    Int               @default(1)
  closingDate      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  applications     JobApplication[]

  @@map("jobs")
}

model Candidate {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  resumeUrl    String?
  linkedinUrl  String?
  source       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[]

  @@map("candidates")
}

model JobApplication {
  id           String            @id @default(uuid())
  jobId        String
  job          Job               @relation(fields: [jobId], references: [id])
  candidateId  String
  candidate    Candidate         @relation(fields: [candidateId], references: [id])
  status       ApplicationStatus @default(APPLIED)
  recruiterId  String?
  recruiter    Employee?         @relation(fields: [recruiterId], references: [id])
  coverLetter  String?
  notes        String?
  interviewDate DateTime?
  salaryExpectation Decimal?     @db.Decimal(12, 2)
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("job_applications")
}

// ─── Performance ──────────────────────────────────────────────────────────────
model PerformanceReview {
  id           String            @id @default(uuid())
  employeeId   String
  employee     Employee          @relation("RevieweeReviews", fields: [employeeId], references: [id])
  reviewerId   String
  reviewer     Employee          @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  period       String            // e.g. "Q1 2025"
  rating       PerformanceRating
  goals        Json              @default("[]")
  strengths    String?
  improvements String?
  feedback     String?
  isSharedWithEmployee Boolean   @default(false)
  reviewedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("performance_reviews")
}

model Goal {
  id          String    @id @default(uuid())
  employeeId  String
  title       String
  description String?
  dueDate     DateTime?
  progress    Int       @default(0) // 0-100
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("goals")
}

// ─── Benefits ─────────────────────────────────────────────────────────────────
model Benefit {
  id          String  @id @default(uuid())
  name        String
  description String?
  type        String  // health, dental, vision, 401k, etc.
  provider    String?
  cost        Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  employees   EmployeeBenefit[]

  @@map("benefits")
}

model EmployeeBenefit {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  benefitId   String
  benefit     Benefit   @relation(fields: [benefitId], references: [id])
  enrolledAt  DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([employeeId, benefitId])
  @@map("employee_benefits")
}

// ─── Onboarding ───────────────────────────────────────────────────────────────
model Onboarding {
  id          String           @id @default(uuid())
  employeeId  String           @unique
  employee    Employee         @relation(fields: [employeeId], references: [id])
  status      OnboardingStatus @default(NOT_STARTED)
  startDate   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tasks       OnboardingTask[]

  @@map("onboardings")
}

model OnboardingTask {
  id           String     @id @default(uuid())
  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id])
  title        String
  description  String?
  isCompleted  Boolean    @default(false)
  dueDate      DateTime?
  completedAt  DateTime?
  assignedTo   String?    // userId
  order        Int        @default(0)

  @@map("onboarding_tasks")
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType @default(INFO)
  title      String
  message    String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  link       String?
  createdAt  DateTime         @default(now())

  @@map("notifications")
}

// ─── Work History ─────────────────────────────────────────────────────────────
model WorkExperience {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?

  @@map("work_experiences")
}

model Education {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  institution  String
  degree       String
  field        String?
  startYear    Int
  endYear      Int?
  gpa          Decimal?  @db.Decimal(4, 2)

  @@map("educations")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────
model Webhook {
  id        String   @id @default(uuid())
  url       String
  secret    String
  events    String[] // e.g. ["employee.created", "payroll.approved"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id])
  event      String
  payload    Json
  statusCode Int?
  response   String?
  attempts   Int      @default(0)
  sentAt     DateTime @default(now())
  success    Boolean  @default(false)

  @@map("webhook_deliveries")
}
