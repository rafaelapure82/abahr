// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                         A U T H   &   U S E R S                          ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  // role              Role      @default(EMPLOYEE)  // REMOVED: using UserRole relation
  isActive             Boolean   @default(true)
  isEmailVerified      Boolean   @default(false)
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  refreshToken         String?
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime? // soft delete

  // Relations
  roles          UserRole[]
  employee       Employee?
  notifications  Notification[]
  auditLogs      AuditLog[]
  webhookConfigs WebhookConfig[]
  createdJobs    JobPosting[]    @relation("CreatedJobs")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "SUPER_ADMIN", "HR_MANAGER"
  description String?
  isSystem    Boolean @default(false) // true for default roles that shouldn't be deleted

  permissions RolePermission[]
  users       UserRole[]

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  onboardingTemplateTasks  OnboardingTemplateTask[]
  offboardingTemplateTasks OffboardingTemplateTask[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String // e.g. "CREATE", "READ", "UPDATE", "DELETE", "MANAGE", "APPROVE"
  resource    String // e.g. "EMPLOYEE", "PAYROLL", "LEAVE", "SETTINGS"
  description String?

  roles RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                        E M P L O Y E E S                                  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model Employee {
  id           String @id @default(uuid())
  employeeCode String @unique // e.g. EMP-0042
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Personal Information ──────────────────────────────────────────────────
  firstName     String
  middleName    String?
  lastName      String
  displayName   String?
  gender        Gender?
  dateOfBirth   DateTime?      @db.Date
  maritalStatus MaritalStatus?
  bloodType     BloodType?
  nationality   String?
  ethnicity     String?
  nationalId    String?        @unique // Cédula de Identidad

  // ── Contact ───────────────────────────────────────────────────────────────
  workPhone     String?
  personalPhone String?
  workEmail     String? // alias, different from login email
  personalEmail String?
  linkedinUrl   String?
  githubUrl     String?
  twitterUrl    String?
  personalWebsiteUrl String?

  // ── Address ───────────────────────────────────────────────────────────────
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // ── Emergency Contact ─────────────────────────────────────────────────────
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // ── Avatar ────────────────────────────────────────────────────────────────
  avatarUrl String?

  // ── Employment ────────────────────────────────────────────────────────────
  jobTitle          String
  employmentType    EmploymentType   @default(FULL_TIME)
  employmentStatus  EmploymentStatus @default(PROBATION)
  hireDate          DateTime         @default(now()) @db.Date
  probationEndDate  DateTime?        @db.Date
  terminationDate   DateTime?        @db.Date
  terminationReason String?

  // ── Org Structure ─────────────────────────────────────────────────────────
  departmentId  String?
  department    Department?     @relation(fields: [departmentId], references: [id])
  positionId    String?
  position      Position?       @relation(fields: [positionId], references: [id])
  managerId     String?
  manager       Employee?       @relation("ReportsTo", fields: [managerId], references: [id])
  directReports Employee[]      @relation("ReportsTo")
  locationId    String?
  location      OfficeLocation? @relation(fields: [locationId], references: [id])

  // ── Compensation ──────────────────────────────────────────────────────────
  baseSalary        Decimal          @default(0) @db.Decimal(14, 2)
  currency          String           @default("USD")
  salaryFrequency   PayrollFrequency @default(MONTHLY)
  bankName          String?
  bankAccountNumber String?
  bankRoutingNumber String?
  taxId             String?

  // ── Work Settings ─────────────────────────────────────────────────────────
  workSchedule String? // JSON: { mon-fri: "09:00-18:00" }
  isRemote     Boolean @default(false)
  timeZone     String  @default("UTC")

  // Soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ── Relations ────────────────────────────────────────────────────────────
  documents           Document[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  attendances         Attendance[]
  payrollItems        PayrollItem[]
  onboarding          Onboarding?
  offboarding         Offboarding?
  performanceReviews  PerformanceReview[]  @relation("RevieweeReviews")
  reviewsGiven        PerformanceReview[]  @relation("ReviewerReviews")
  goals               Goal[]
  feedbackGiven       Feedback360[]        @relation("FeedbackGiver")
  feedbackReceived    Feedback360[]        @relation("FeedbackReceiver")
  benefits            EmployeeBenefit[]
  jobApplications     JobApplication[]     @relation("RecruiterApplications")
  salaryHistories     SalaryHistory[]
  disciplinaryActions DisciplinaryAction[]
  orgChartNodes       OrgChartNode[]
  hiringManagerJobs   JobPosting[]         @relation("HiringManagerJobs")
  orgMovements        OrgMovement[]

  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([deletedAt])
  @@map("employees")
}

// ── Salary history ─────────────────────────────────────────────────────────
model SalaryHistory {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  previousSalary Decimal  @db.Decimal(14, 2)
  newSalary      Decimal  @db.Decimal(14, 2)
  currency       String   @default("USD")
  reason         String?
  effectiveDate  DateTime @db.Date
  approvedBy     String?
  createdAt      DateTime @default(now())

  @@map("salary_histories")
}

// ── Disciplinary Actions ────────────────────────────────────────────────────
model DisciplinaryAction {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  type        String // warning, pip, suspension, termination
  description String
  issuedBy    String?
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  documentUrl String?
  createdAt   DateTime  @default(now())

  @@map("disciplinary_actions")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                   D E P A R T M E N T S   &   O R G                      ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model Department {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  description  String?
  color        String? // hex for org chart UI
  icon         String?
  overtimeRate Float   @default(1.5)
  budget       Decimal @default(0) @db.Decimal(14, 2)
  costCenter   String?

  // Hierarchy
  parentId String?
  parent   Department?  @relation("SubDepartments", fields: [parentId], references: [id])
  children Department[] @relation("SubDepartments")

  // Manager
  headId String? // Employee.id — circular reference avoided via raw string

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees      Employee[]
  positions      Position[]
  payrolls       Payroll[]
  orgChartNodes  OrgChartNode[]
  payrollPeriods PayrollPeriod[]
  jobPostings    JobPosting[]
  history        DeptHistory[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("departments")
}

model Position {
  id           String     @id @default(uuid())
  title        String
  code         String     @unique
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  level        Int        @default(1) // seniority level
  minSalary    Decimal?   @db.Decimal(14, 2)
  maxSalary    Decimal?   @db.Decimal(14, 2)
  targetCount  Int        @default(1) // planning/headcount
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  employees   Employee[]
  jobPostings JobPosting[]

  @@map("positions")
}

model OfficeLocation {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  country   String?
  timeZone  String   @default("UTC")
  isHQ      Boolean  @default(false)
  latitude  Float?
  longitude Float?
  radius    Int      @default(500) // validation radius in meters
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("office_locations")
}

// ── Movement / History Tracking ──────────────────────────────────────────
model DeptHistory {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  action       String // "MANAGER_CHANGE", "BUDGET_UPDATE", "RENAME"
  previousValue String?
  newValue      String?
  changedById   String // User.id
  effectiveDate DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@map("dept_history")
}

model OrgMovement {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  oldDeptId       String?
  newDeptId       String?
  oldPositionId   String?
  newPositionId   String?
  oldManagerId    String?
  newManagerId    String?
  reason          String?
  effectiveDate   DateTime @default(now())
  processedById   String // User.id
  createdAt       DateTime @default(now())

  @@map("org_movements")
}

// ── Organization Chart ─────────────────────────────────────────────────────
model OrgChartNode {
  id           String         @id @default(uuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  parentNodeId String?
  parentNode   OrgChartNode?  @relation("OrgNodeChildren", fields: [parentNodeId], references: [id])
  childNodes   OrgChartNode[] @relation("OrgNodeChildren")
  level        Int            @default(0)
  order        Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([employeeId])
  @@map("org_chart_nodes")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                         D O C U M E N T S                                ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model Document {
  id             String       @id @default(uuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           DocumentType @default(OTHER)
  name           String
  description    String?
  fileUrl        String
  fileKey        String? // S3 key or local path
  fileSize       Int? // bytes
  mimeType       String?
  isVerified     Boolean      @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?
  expiresAt      DateTime?
  isConfidential Boolean      @default(false)
  uploadedAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([employeeId, type])
  @@index([expiresAt])
  @@map("documents")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║               L E A V E S   /   P T O                                    ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model LeavePolicy {
  id                 String    @id @default(uuid())
  name               String
  leaveType          LeaveType
  daysAllowed        Decimal   @db.Decimal(5, 1)
  carryoverDays      Decimal   @default(0) @db.Decimal(5, 1)
  accrualRate        Decimal?  @db.Decimal(5, 2) // days per month
  requiresApproval   Boolean   @default(true)
  minNoticeDays      Int       @default(0)
  maxConsecutiveDays Int?
  eligibleAfterDays  Int       @default(0) // probation guard
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([leaveType])
  @@map("leave_policies")
}

model LeaveBalance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType
  year       Int
  allocated  Decimal   @default(0) @db.Decimal(5, 1)
  used       Decimal   @default(0) @db.Decimal(5, 1)
  pending    Decimal   @default(0) @db.Decimal(5, 1)
  carryOver  Decimal   @default(0) @db.Decimal(5, 1)
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType
  status     LeaveStatus @default(PENDING)

  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  daysRequested Decimal  @db.Decimal(5, 1)
  isHalfDay     Boolean  @default(false)
  halfDayPeriod String? // "morning" | "afternoon"

  reason        String?
  attachmentUrl String?

  // Approval workflow
  approverId    String? // Employee.id
  approverNotes String?
  approvedAt    DateTime?
  rejectedAt    DateTime?

  // HR override
  hrReviewerId String?
  hrNotes      String?
  hrReviewedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                       A T T E N D A N C E                                ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)

  checkIn       DateTime?
  checkOut      DateTime?
  breakMinutes  Int       @default(0)
  hoursWorked   Decimal?  @db.Decimal(5, 2)
  overtimeHours Decimal   @default(0) @db.Decimal(5, 2)

  isRemote   Boolean @default(false)
  locationId String?
  latitude   Float?
  longitude  Float?

  note       String?
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendances")
}

model PublicHoliday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @db.Date
  country   String   @default("US")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date, country])
  @@map("public_holidays")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                          P A Y R O L L                                   ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model PayrollPeriod {
  id           String           @id @default(uuid())
  name         String // "March 2025"
  frequency    PayrollFrequency @default(MONTHLY)
  startDate    DateTime         @db.Date
  endDate      DateTime         @db.Date
  payDate      DateTime         @db.Date
  status       PayrollStatus    @default(DRAFT)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])

  processedBy String?
  processedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayrollItem[]

  @@map("payroll_periods")
}

// Alias for backward compat
model Payroll {
  id              String        @id @default(uuid())
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id])
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  payDate         DateTime?     @db.Date
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @db.Decimal(14, 2)
  totalNet        Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(14, 2)
  totalBonuses    Decimal       @default(0) @db.Decimal(14, 2)
  currency        String        @default("USD")
  processedBy     String?
  processedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items PayrollItem[]

  @@map("payrolls")
}

model PayrollItem {
  id         String   @id @default(uuid())
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Earnings
  baseSalary    Decimal @db.Decimal(14, 2)
  regularHours  Decimal @default(0) @db.Decimal(6, 2)
  overtimeHours Decimal @default(0) @db.Decimal(6, 2)
  overtimeRate  Decimal @default(1.5) @db.Decimal(4, 2)
  overtimePay   Decimal @default(0) @db.Decimal(14, 2)
  grossPay      Decimal @db.Decimal(14, 2)
  netPay        Decimal @db.Decimal(14, 2)
  currency      String  @default("USD")

  // Working days
  workingDays  Int     @default(0)
  attendedDays Int     @default(0)
  leaveDays    Decimal @default(0) @db.Decimal(5, 1)
  absenceDays  Decimal @default(0) @db.Decimal(5, 1)

  // Relations
  deductions PayrollDeduction[]
  bonuses    PayrollBonus[]

  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  payrollPeriod   PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId String?

  @@unique([payrollId, employeeId])
  @@map("payroll_items")
}

model PayrollDeduction {
  id            String        @id @default(uuid())
  payrollItemId String
  payrollItem   PayrollItem   @relation(fields: [payrollItemId], references: [id])
  type          DeductionType
  name          String
  amount        Decimal       @db.Decimal(14, 2)
  percentage    Decimal?      @db.Decimal(5, 4) // if percentage-based
  isPreTax      Boolean       @default(false)
  notes         String?

  @@map("payroll_deductions")
}

model PayrollBonus {
  id            String      @id @default(uuid())
  payrollItemId String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id])
  type          BonusType
  name          String
  amount        Decimal     @db.Decimal(14, 2)
  isTaxable     Boolean     @default(true)
  notes         String?

  @@map("payroll_bonuses")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                       R E C R U I T M E N T                              ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model JobPosting {
  id           String      @id @default(uuid())
  title        String
  code         String?     @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id])
  status       JobStatus   @default(DRAFT)

  description      String
  requirements     String?
  responsibilities String?
  benefits         String?
  skills           String[] // array of required skills

  employmentType  EmploymentType @default(FULL_TIME)
  experienceYears Int?
  educationLevel  String?
  salaryMin       Decimal?       @db.Decimal(14, 2)
  salaryMax       Decimal?       @db.Decimal(14, 2)
  currency        String         @default("USD")
  showSalary      Boolean        @default(false)

  location      String?
  isRemote      Boolean   @default(false)
  openingsCount Int       @default(1)
  filledCount   Int       @default(0)
  closingDate   DateTime?

  hiringManagerId String? // Employee.id
  hiringManager   Employee? @relation("HiringManagerJobs", fields: [hiringManagerId], references: [id])
  createdById     String? // User.id
  createdBy       User?     @relation("CreatedJobs", fields: [createdById], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  applications   JobApplication[]
  pipelineStages PipelineStage[]

  @@index([status])
  @@index([deletedAt])
  @@map("job_postings")
}

model PipelineStage {
  id        String     @id @default(uuid())
  jobId     String
  job       JobPosting @relation(fields: [jobId], references: [id])
  name      String // "Screening", "Technical Interview", etc.
  order     Int        @default(0)
  isDefault Boolean    @default(false)
  color     String?
  createdAt DateTime   @default(now())

  applications JobApplication[]

  @@unique([jobId, order])
  @@map("pipeline_stages")
}

model Candidate {
  id              String  @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  currentTitle    String?
  currentCompany  String?
  experienceYears Int?

  resumeUrl      String?
  coverLetterUrl String?
  portfolioUrl   String?
  linkedinUrl    String?
  githubUrl      String?

  source CandidateSource @default(OTHER)
  skills String[]
  tags   String[]
  notes  String?
  rating Int? // 1-5 HR rating

  referredBy      String? // Employee.id
  isBlacklisted   Boolean @default(false)
  blacklistReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  applications JobApplication[]

  @@index([email])
  @@index([deletedAt])
  @@map("candidates")
}

model JobApplication {
  id             String            @id @default(uuid())
  jobId          String
  job            JobPosting        @relation(fields: [jobId], references: [id])
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id])
  status         ApplicationStatus @default(APPLIED)
  currentStageId String?
  currentStage   PipelineStage?    @relation(fields: [currentStageId], references: [id])

  recruiterId String?
  recruiter   Employee? @relation("RecruiterApplications", fields: [recruiterId], references: [id])

  coverLetter       String?
  salaryExpectation Decimal?  @db.Decimal(14, 2)
  expectedStartDate DateTime? @db.Date
  notes             String?
  internalNotes     String? // HR only

  rejectionReason String?
  offerAmount     Decimal?  @db.Decimal(14, 2)
  offerExtendedAt DateTime?
  offerAcceptedAt DateTime?
  offerDeclinedAt DateTime?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hrSignature String? // Base64 signature image
  interviews Interview[]

  @@unique([jobId, candidateId])
  @@index([status])
  @@map("job_applications")
}

model Interview {
  id             String         @id @default(uuid())
  applicationId  String
  application    JobApplication @relation(fields: [applicationId], references: [id])
  title          String // "Technical Round 1"
  scheduledAt    DateTime
  durationMins   Int            @default(60)
  location       String? // or video link
  interviewerIds String[] // Employee ids
  type           String // phone, video, onsite, panel
  notes          String?
  feedback       String?
  rating         Int? // 1-5
  outcome        String? // passed, failed, rescheduled
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("interviews")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║         O N B O A R D I N G   /   O F F B O A R D I N G                  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ── Task Templates (reusable blueprints) ──────────────────────────────────
model OnboardingTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       OnboardingTemplateTask[]
  onboardings Onboarding[]
}

model OnboardingTemplateTask {
  id             String             @id @default(uuid())
  templateId     String
  template       OnboardingTemplate @relation(fields: [templateId], references: [id])
  title          String
  description    String?
  category       TaskCategory       @default(OTHER)
  order          Int                @default(0)
  dueDays        Int                @default(7) // days after hire date
  assignToRole   Role?              @relation(fields: [roleId], references: [id]) // who is responsible
  isRequired     Boolean            @default(true)
  checklistItems String[] // sub-items
  roleId         String?
}

model OffboardingTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks        OffboardingTemplateTask[]
  offboardings Offboarding[]
}

model OffboardingTemplateTask {
  id             String              @id @default(uuid())
  templateId     String
  template       OffboardingTemplate @relation(fields: [templateId], references: [id])
  title          String
  description    String?
  category       TaskCategory        @default(OTHER)
  order          Int                 @default(0)
  dueDays        Int                 @default(-3) // days before last day (negative = before)
  assignToRole   Role?               @relation(fields: [roleId], references: [id])
  isRequired     Boolean             @default(true)
  checklistItems String[]
  roleId         String?
}

// ── Instance: one per employee ─────────────────────────────────────────────
model Onboarding {
  id          String              @id @default(uuid())
  employeeId  String              @unique
  employee    Employee            @relation(fields: [employeeId], references: [id])
  templateId  String?
  template    OnboardingTemplate? @relation(fields: [templateId], references: [id])
  status      BoardingStatus      @default(NOT_STARTED)
  startDate   DateTime?           @db.Date
  targetDate  DateTime?           @db.Date
  completedAt DateTime?
  hrOwnerId   String? // HR person responsible
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tasks OnboardingTask[]

  @@map("onboardings")
}

model OnboardingTask {
  id             String       @id @default(uuid())
  onboardingId   String
  onboarding     Onboarding   @relation(fields: [onboardingId], references: [id])
  title          String
  description    String?
  category       TaskCategory @default(OTHER)
  status         TaskStatus   @default(PENDING)
  order          Int          @default(0)
  dueDate        DateTime?    @db.Date
  assignedToId   String? // User.id
  completedAt    DateTime?
  completedById  String?
  notes          String?
  checklistItems Json         @default("[]") // [{ label, done }]
  isRequired     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("onboarding_tasks")
}

model Offboarding {
  id              String               @id @default(uuid())
  employeeId      String               @unique
  employee        Employee             @relation(fields: [employeeId], references: [id])
  templateId      String?
  template        OffboardingTemplate? @relation(fields: [templateId], references: [id])
  status          BoardingStatus       @default(NOT_STARTED)
  lastWorkDay     DateTime?            @db.Date
  completedAt     DateTime?
  exitInterviewAt DateTime?
  exitReason      String?
  hrOwnerId       String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tasks OffboardingTask[]

  @@map("offboardings")
}

model OffboardingTask {
  id             String       @id @default(uuid())
  offboardingId  String
  offboarding    Offboarding  @relation(fields: [offboardingId], references: [id])
  title          String
  description    String?
  category       TaskCategory @default(OTHER)
  status         TaskStatus   @default(PENDING)
  order          Int          @default(0)
  dueDate        DateTime?    @db.Date
  assignedToId   String?
  completedAt    DateTime?
  completedById  String?
  notes          String?
  checklistItems Json         @default("[]")
  isRequired     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("offboarding_tasks")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                    P E R F O R M A N C E                                  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model ReviewCycle {
  id        String   @id @default(uuid())
  name      String // "Q1 2025", "Annual 2025"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  dueDate   DateTime @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  templateId String?
  template   ReviewTemplate? @relation(fields: [templateId], references: [id])
  
  reviews PerformanceReview[]

  @@map("review_cycles")
}

model PerformanceReview {
  id      String       @id @default(uuid())
  cycleId String?
  cycle   ReviewCycle? @relation(fields: [cycleId], references: [id])

  employeeId String
  employee   Employee @relation("RevieweeReviews", fields: [employeeId], references: [id])
  reviewerId String
  reviewer   Employee @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  status        ReviewStatus       @default(DRAFT)
  overallRating PerformanceRating?
  overallScore  Decimal?           @db.Decimal(4, 2) // 0.00–5.00

  // Self review
  selfRating   PerformanceRating?
  selfComments String?

  // Manager review
  managerStrengths    String?
  managerImprovements String?
  managerComments     String?

  // HR review
  hrComments   String?
  hrApprovedAt DateTime?

  // Employee acknowledgement
  isAcknowledged   Boolean   @default(false)
  acknowledgedAt   DateTime?
  employeeComments String?

  isSharedWithEmployee Boolean   @default(false)
  sharedAt             DateTime?

  period    String? // backup if no cycle: "Q3 2025"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria    ReviewCriterion[]
  feedback360 Feedback360[]
  goals       Goal[]

  @@map("performance_reviews")
}

model ReviewCriterion {
  id             String             @id @default(uuid())
  reviewId       String
  review         PerformanceReview  @relation(fields: [reviewId], references: [id])
  name           String // "Communication", "Technical Skills"
  description    String?
  weight         Int                @default(1) // relative weight
  selfRating     PerformanceRating?
  selfComment    String?
  managerRating  PerformanceRating?
  managerComment String?
  score          Decimal?           @db.Decimal(4, 2)

  @@map("review_criteria")
}

model Feedback360 {
  id           String             @id @default(uuid())
  reviewId     String
  review       PerformanceReview  @relation(fields: [reviewId], references: [id])
  giverId      String
  giver        Employee           @relation("FeedbackGiver", fields: [giverId], references: [id])
  receiverId   String
  receiver     Employee           @relation("FeedbackReceiver", fields: [receiverId], references: [id])
  relationship String // "peer", "subordinate", "manager", "cross-team"
  rating       PerformanceRating?
  strengths    String?
  improvements String?
  comments     String?
  isAnonymous  Boolean            @default(true)
  submittedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@map("feedback_360")
}

model Goal {
  id          String             @id @default(uuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id])
  reviewId    String?
  review      PerformanceReview? @relation(fields: [reviewId], references: [id])
  title       String
  description String?
  status      GoalStatus         @default(NOT_STARTED)
  priority    GoalPriority       @default(MEDIUM)
  progress    Int                @default(0) // 0-100
  startDate   DateTime?          @db.Date
  dueDate     DateTime?          @db.Date
  completedAt DateTime?
  kpi         String? // measurable success criteria
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("goals")
}

// ── Templates ─────────────────────────────────────────────────────────────

model ReviewTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria TemplateCriterion[]
  cycles   ReviewCycle[]

  @@map("review_templates")
}

model TemplateCriterion {
  id          String         @id @default(uuid())
  templateId  String
  template    ReviewTemplate @relation(fields: [templateId], references: [id])
  name        String
  description String?
  weight      Int            @default(1)

  @@map("template_criteria")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                         B E N E F I T S                                   ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model BenefitPlan {
  id           String          @id @default(uuid())
  name         String
  category     BenefitCategory
  description  String?
  provider     String?
  policyNumber String?

  // Cost
  employerCost Decimal? @db.Decimal(12, 2)
  employeeCost Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  // Eligibility
  minTenureDays Int              @default(0)
  eligibleTypes EmploymentType[] // FULL_TIME only, etc.

  enrollmentDeadline DateTime?
  effectiveDate      DateTime? @db.Date
  expirationDate     DateTime? @db.Date

  details   Json? // specific plan JSON details
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments EmployeeBenefit[]

  @@map("benefit_plans")
}

model EmployeeBenefit {
  id          String           @id @default(uuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  planId      String
  plan        BenefitPlan      @relation(fields: [planId], references: [id])
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  effectiveAt DateTime?        @db.Date
  expiresAt   DateTime?        @db.Date
  waiveReason String?
  dependents  Json? // [{name, dob, relation}]
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, planId])
  @@map("employee_benefits")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                   N O T I F I C A T I O N S                               ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model Notification {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus  @default(PENDING)
  title       String
  message     String
  data        Json? // extra payload
  link        String? // deep link URL
  isRead      Boolean             @default(false)
  readAt      DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  failReason  String?
  retryCount  Int                 @default(0)
  scheduledAt DateTime? // for deferred notifications
  createdAt   DateTime            @default(now())

  @@index([userId, isRead])
  @@index([scheduledAt])
  @@map("notifications")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  htmlBody  String
  textBody  String?
  variables String[] // list of template vars like {{firstName}}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                        A U D I T   L O G S                                ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model AuditLog {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  action       AuditAction
  resource     String // table/model name
  resourceId   String?
  description  String?
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  duration     Int? // ms
  isSuccess    Boolean     @default(true)
  errorMessage String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                       W E B H O O K S                                     ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model WebhookConfig {
  id          String         @id @default(uuid())
  name        String
  url         String
  secret      String // HMAC signing secret
  events      WebhookEvent[]
  headers     Json? // custom headers
  status      WebhookStatus  @default(ACTIVE)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhook_configs")
}

model WebhookDelivery {
  id           String        @id @default(uuid())
  webhookId    String
  webhook      WebhookConfig @relation(fields: [webhookId], references: [id])
  event        WebhookEvent
  payload      Json
  statusCode   Int?
  responseBody String?
  attempt      Int           @default(1)
  isSuccess    Boolean       @default(false)
  errorMessage String?
  duration     Int? // ms
  sentAt       DateTime      @default(now())
  nextRetryAt  DateTime?

  @@index([webhookId, event])
  @@index([isSuccess])
  @@map("webhook_deliveries")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                     S Y S T E M   C O N F I G                             ║
// ╚══════════════════════════════════════════════════════════════════════════╝

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  isPublic  Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}
