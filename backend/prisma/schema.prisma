// ══════════════════════════════════════════════════════════════════════════════
//  ABA Talent Management – Prisma Schema (Complete)
//  PostgreSQL / NeonDB
//  Conventions:
//    - All PKs are UUID (@default(uuid()))
//    - Soft delete via deletedAt DateTime?
//    - createdAt / updatedAt on every mutable model
//    - Explicit @@map() on every table for clean SQL names
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                              E N U M S                                   ║
// ╚══════════════════════════════════════════════════════════════════════════╝

