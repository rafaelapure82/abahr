# ══════════════════════════════════════════════════════════════
#  ABA Talent Management – Environment Variables Template
#  Copy this file to .env and fill in your values
#  NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME="ABA Talent Management"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# ─── Ports ────────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=4200
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── PostgreSQL (Local Dev) ────────────────────────────────────
POSTGRES_USER=aba_user
POSTGRES_PASSWORD=aba_secure_pass
POSTGRES_DB=aba_hrm

# ─── NeonDB (Production) ──────────────────────────────────────
# Uncomment and set for production:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/aba_hrm?sslmode=require"

# ─── Database URL (Prisma) ─────────────────────────────────────
DATABASE_URL="postgresql://aba_user:aba_secure_pass@localhost:5432/aba_hrm"

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=aba_redis_pass
REDIS_URL="redis://:aba_redis_pass@localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_super_secret_refresh_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ABA Talent <noreply@abatalent.com>"

# ─── AWS S3 (document storage) ────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=aba-talent-docs

# ─── Alternative: Local file storage ──────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ─── Resend (transactional email – production) ─────────────────
RESEND_API_KEY=

# ─── Pagination defaults ──────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Webhooks ─────────────────────────────────────────────────
WEBHOOK_SECRET=CHANGE_ME_webhook_signing_secret

# ─── Payroll ──────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
TAX_RATE_PERCENTAGE=0

# ─── Frontend (Angular) ───────────────────────────────────────
NG_APP_API_URL=http://localhost:3000/api/v1
NG_APP_WS_URL=ws://localhost:3000
NG_APP_ENV=development
